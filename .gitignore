# Composer dependencies (generated by `composer install` / `composer update`)
/vendor/
/tools/*/vendor/

# Root lock file: a bundle/library should not commit its own composer.lock.
# (The pinned tool locks under /tools/*/composer.lock stay tracked.)
/composer.lock

# Local Composer binary (copied into the bundle because it is not installed globally)
/composer
/composer.phar

# PHPUnit
.phpunit.result.cache
.phpunit.cache/

# IDE
/.idea/
/.vscode/

# OS
.DS_Store
Thumbs.db
