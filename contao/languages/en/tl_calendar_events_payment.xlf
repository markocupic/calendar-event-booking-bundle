      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.uuid.0">
        <source>Payment UUID</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.uuid.1">
        <source>The UUID linking this payment to the order.</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.bookingUuid.0">
        <source>Booking UUID</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.bookingUuid.1">
        <source>The UUID linking this payment to the booking.</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.orderUuid.0">
        <source>Order UUID</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.orderUuid.1">
        <source>The UUID of the related order record.</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.type.0">
        <source>Payment type</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.type.1">
        <source>The type of this payment entry (e.g. capture or refund).</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.provider.0">
        <source>Payment provider</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.provider.1">
        <source>The payment provider that processed this transaction.</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.providerOrderId.0">
        <source>Provider order ID</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.providerOrderId.1">
        <source>The external order ID assigned by the provider.</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.providerCaptureId.0">
        <source>Provider capture ID</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.providerCaptureId.1">
        <source>The capture ID assigned by the provider.</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.captureTime.0">
        <source>Capture time</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.captureTime.1">
        <source>The UNIX timestamp when the payment was captured.</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.status.0">
        <source>Status</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.status.1">
        <source>The transaction status reported by the provider.</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.isFinal.0">
        <source>Final capture</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.isFinal.1">
        <source>Indicates whether this is the final capture of the order.</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.grossAmount.0">
        <source>Gross amount</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.grossAmount.1">
        <source>The total amount the customer paid (including taxes).</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.netAmountReceived.0">
        <source>Net amount received</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.netAmountReceived.1">
        <source>The payout amount after provider fees have been deducted.</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.captureFee.0">
        <source>Provider fee</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.captureFee.1">
        <source>The fee charged by the payment provider.</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.currencyCode.0">
        <source>Currency code</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.currencyCode.1">
        <source>The ISO currency code of the gross amount, i.e. the currency the customer paid in (e.g. EUR).</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.exchangeRate.0">
        <source>Exchange rate</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.exchangeRate.1">
        <source>The rate the provider applied to convert the gross amount into the settlement currency. 1 when both currencies are the same.</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.settlementGrossAmount.0">
        <source>Gross amount in settlement currency</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.settlementGrossAmount.1">
        <source>The gross amount converted into the settlement currency. Minus the provider fee this gives the net amount received.</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.settlementCurrencyCode.0">
        <source>Settlement currency code</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.settlementCurrencyCode.1">
        <source>The ISO currency code the provider settled in. Applies to the net amount received and the provider fee. Empty means the provider did not report it.</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.providerRefundId.0">
        <source>Provider refund ID</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.providerRefundId.1">
        <source>The unique identification number under which the payment provider processed the refund.</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.refundTime.0">
        <source>Refund time</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.refundTime.1">
        <source>The UNIX timestamp when the refund was processed by the provider.</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.refundAmount.0">
        <source>Refund amount</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.refundAmount.1">
        <source>The refunded amount, in the currency of the gross amount (usually negative for internal calculations).</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.refundExchangeRate.0">
        <source>Refund exchange rate</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.refundExchangeRate.1">
        <source>The rate the provider applied when the refund was issued. Not the rate of the original payment. 1 when both currencies are the same.</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.refundSettlementAmount.0">
        <source>Refund amount in settlement currency</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.refundSettlementAmount.1">
        <source>The refunded amount converted into the settlement currency, before the refund fee. This is what the refund took off the account.</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.refundFee.0">
        <source>Refund fee</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.refundFee.1">
        <source>The fee charged by the payment provider for processing the refund, in the settlement currency.</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.details.0">
        <source>Details (raw payload)</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.details.1">
        <source>Stores the raw provider payload for auditing and debugging.</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.notes.0">
        <source>Notes</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.notes.1">
        <source>Internal notes for this payment entry.</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.log.0">
        <source>Log</source>
      </trans-unit>
      <trans-unit id="tl_calendar_events_payment.log.1">
        <source>Please enter the log text.</source>
      </trans-unit>
